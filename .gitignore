# NIKINIKI public repository ignores

.DS_Store
.idea/
.vscode/
.vs/
*.pro.user

# Local tool and research material
.tmp/
.tools/
.codex-remote-attachments/
release/
__pycache__/
*.py[cod]

# Local signing and unpacked SIS inspection output
/Chain/*.pem
/Chain/*.key
/Chain/*.cer
/NIKINIKI_*_debug*/
/NIKINIKI_*_release*/
/e7_cmp_gate_signed/
/nikiniki_devvideo_capability_probe/

# Symbian build/package outputs
symbian/out/
symbian/app/epoc32/
symbian/app/.make.cache
symbian/app/Makefile
symbian/app/bld.inf
symbian/app/*.loc
symbian/app/*_exe.mmp
symbian/app/*_reg.rss
symbian/app/wiliwili_*.rss
symbian/app/*_installer.pkg
symbian/app/*_stub.pkg
symbian/app/*_template.pkg
symbian/app/qrc_*.cpp
symbian/app/moc_*.cpp
symbian/app/obj/
symbian/app/moc/
symbian/app/ui/
symbian/app/rcc/

# qmake output accidentally generated below an `app/player` shadow directory.
# Keep this file-level list narrow so a future real source directory is visible.
symbian/app/player/.make.cache
symbian/app/player/Makefile
symbian/app/player/bld.inf
symbian/app/player/*.loc
symbian/app/player/*_exe.mmp
symbian/app/player/*_reg.rss
symbian/app/player/*_installer.pkg
symbian/app/player/*_stub.pkg
symbian/app/player/*_template.pkg
symbian/app/player/qrc_*.cpp
symbian/app/player/moc_*.cpp

symbian/probes/*/.make.cache
symbian/probes/*/Makefile
symbian/probes/*/bld.inf
symbian/probes/*/*.loc
symbian/probes/*/*_exe.mmp
symbian/probes/*/*_reg.rss
symbian/probes/*/wiliwili_*.rss
symbian/probes/*/*_installer.pkg
symbian/probes/*/*_stub.pkg
symbian/probes/*/*_template.pkg
symbian/probes/*/obj/
symbian/probes/*/moc/
symbian/probes/*/ui/
symbian/probes/*/rcc/

symbian/third_party/ppsspp_ffmpeg/build/
symbian/third_party/ppsspp_ffmpeg/include/
symbian/third_party/ppsspp_ffmpeg/lib/
symbian/third_party/mongoose_compat/tests/*.exe
symbian/third_party/mongoose_compat/tests/*.obj

# Never commit binaries, packages or signing material.  The two explicit Qt
# runtime installers below are the only documented public-repository exception.
*.sis
!prerequisites/Qt-4.7.403-for-Anna.sis
!prerequisites/QtMobility-1.2.1-for-Anna.sis
*.sisx
*.exe
*.dll
*.lib
*.a
*.o
*.obj
*.pfx
*.p12
*.key
*.cer
*.csr
*.dmp
*.log
